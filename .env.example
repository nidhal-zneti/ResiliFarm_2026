# ResiliFarm Mobile — environment variables
#
# Base URL of the ResiliFarm FastAPI backend (include the /api/v1 suffix).
# - iOS simulator / web:      http://localhost:8000/api/v1
# - Android emulator:         http://10.0.2.2:8000/api/v1
# - Physical device (LAN):    http://192.168.x.x:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# While the farmer endpoints are being built the app uses clearly-labelled mock
# data. Set to "false" once the backend is ready.
EXPO_PUBLIC_USE_MOCK=true
