# Local SQLite needs no environment variables.
# Docker Compose requires a unique database password (no default).
POSTGRES_PASSWORD=
# Optional local PostgreSQL connection:
# DATABASE_URL=postgresql+psycopg://resilifarm:YOUR_URL_ENCODED_PASSWORD@localhost:5432/resilifarm
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signing secret for account JWT tokens (change for anything beyond a local demo).
JWT_SECRET=

# Optional OpenAI-compatible Studio planning provider. Output is restricted to known profiles/options.
STUDIO_AI_BASE_URL=
STUDIO_AI_API_KEY=
STUDIO_AI_MODEL=
